/* Tufte-style shortcode styles (sidenote, marginnote, newthought, epigraph, figure) */

/* Epigraph */
.epigraph {
  margin: 3em 0;
}
.epigraph > blockquote {
  margin-top: 3em;
  margin-bottom: 3em;
  font-style: italic;
}
.epigraph > blockquote > footer {
  font-style: normal;
}
.epigraph > blockquote > footer > cite {
  font-style: italic;
}

/* Sidenotes and marginnotes — click-to-reveal inline notes */
.sidenote,
.marginnote {
  display: none;
}

.marginnote-ind,
.sidenote-number {
  position: relative;
  vertical-align: baseline;
  user-select: none;
}

label.sidenote-number,
label.marginnote-ind {
  display: inline;
  font-size: 0.78rem;
  top: -0.4rem;
  position: relative;
  cursor: pointer;
  color: var(--link-color);
}

span.sidenote-number,
span.marginnote-ind {
  font-size: 0.8rem;
  color: var(--link-color);
}

.marginnote .code,
.sidenote .code {
  font-size: 0.85rem;
}

.margin-toggle:checked + .sidenote,
.margin-toggle:checked + .marginnote {
  display: block;
  margin: 0.6rem 0 0.8rem 0;
  padding: 0.5rem 0.75rem;
  border-left: 3px solid var(--link-color);
  font-size: 0.88rem;
  line-height: 1.5;
  color: var(--list-color);
  font-style: italic;
}

/* Newthought */
.newthought {
  font-variant: small-caps;
  font-size: 1.2em;
}

/* Toggle controls for collapsible margin notes on small screens */
.margin-toggle {
  cursor: pointer;
}

input.margin-toggle {
  position: absolute;
  outline: none;
  opacity: 0;
  width: 1px;
  height: 1px;
  margin-left: 5px;
  margin-top: 5px;
  z-index: -100;
}

label:has(+ input.margin-toggle:focus) {
  outline: 5px auto -webkit-focus-ring-color;
  outline-offset: -3px;
}

label.sidenote-number {
  display: inline;
}

label.marginnote-ind {
  display: none;
}

/* Full-width elements */
.fullwidth {
  max-width: 90%;
  clear: both;
}

/* Figure shortcode */
figure {
  padding: 0;
  border: 0;
  max-width: 55%;
  margin: 0 0 2em 0;
}

figure.fullwidth {
  max-width: 90%;
}

figcaption {
  float: right;
  clear: right;
  margin-right: -48%;
  margin-top: 0;
  margin-bottom: 0;
  font-size: 0.95rem;
  line-height: 1.5;
  vertical-align: baseline;
  position: relative;
  max-width: 40%;
}

figure.fullwidth figcaption {
  margin-right: 24%;
}

/* Mobile: figures go full width */
@media (max-width: 760px) {
  figure {
    max-width: 90%;
  }
  figcaption,
  figure.fullwidth figcaption {
    margin-right: 0;
    max-width: none;
    float: none;
  }
}
