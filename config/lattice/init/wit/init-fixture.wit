package lattice:plugin-host@0.1.0;

/// CI.5 fixture world — the shape a real `init.rs` uses for DEFERRED plugin
/// config (`with-eval-after-load`; config-and-init.md). It `provides` the
/// `events` seam (it subscribes to `plugin-loaded`) and IMPORTS `modes` (it
/// calls `enable-mode` from its handler when the awaited plugin loads). The host
/// instantiates it via the events drain (superset linker satisfies the `modes`
/// import); the `on-event` handler runs in that store, which carries the bus, so
/// `enable-mode` can publish its `mode-enablement-requested` request.
world init-fixture {
    import events;
    import modes;
    import config;
    use types.{event};
    use events.{wake-id};

    export register-events: func();
    export on-event: func(handler: u32, ev: event);
    /// OC.2: the events drain instantiates against the `events-plugin`
    /// bindings, and a component must export every function those bindings
    /// name — so a world that declares its own event exports declares this one
    /// too, even when (as here) it arms no wakes and the host never calls it.
    export on-wake: func(id: wake-id);
}
