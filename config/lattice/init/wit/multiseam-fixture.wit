package lattice:plugin-host@0.1.0;

/// AP.1 spike world: proves ONE component can `provide` the SYNC grammar seam
/// AND the async `modes` + `config` seams simultaneously — the `auto-pair` shape
/// (grammar actions + an `auto-pair-mode` minor mode + the `auto-pair.style`
/// option). The host instantiates the SAME `.wasm` once per seam through each
/// per-seam world's bindings (`GrammarPlugin` sync against the grammar linker;
/// `ModesPlugin` / `ConfigPlugin` async against the async linker); both linkers
/// are supersets carrying every sync seam import, so the fixed import set
/// resolves either way.
///
/// `logging` is intentionally NOT imported: keeping it out of the combined world
/// preserves the "no logging reachable from the grammar hot path" invariant (the
/// grammar linker gains only the sync `modes` / `config` register funcs, never
/// `log`). A test vehicle — the real `auto-pair` world lands at AP.1 proper.
///
/// OM.11 adds `host-services`, because org provides BOTH `grammar` and
/// `picker-source` and a picker source needs `walk`. A component's imports must
/// ALL resolve on EVERY linker it is instantiated against, so without it on the
/// sync grammar linker the whole component failed to load — this world is where
/// that is caught, since org lives in another repo.
world multiseam-fixture {
    import grammar;
    import buffer;
    import tree-sitter;
    import modes;
    import config;
    import host-services;
    // OC.3 / ML.6: the modeline-contribution seam. Declared here for the same
    // reason `host-services` is — one artefact, one import set, instantiated
    // against BOTH linkers, so the fixture proves the async seam registers a
    // segment AND that the same component's grammar seam cannot.
    import ui;
    // OC.6: the events seam, imported (not the whole `events-plugin` world) so
    // the fixture proves the SYNC grammar linker satisfies it — org declares it
    // for its clock's wake, and an import absent from that linker fails the
    // whole component rather than one seam.
    import events;

    export register-grammar: func();
    export grammar-callbacks;
    export register-modes: func();
    export register-options: func();
}
